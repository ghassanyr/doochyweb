# ── Doochy ───────────────────────────────────────────────────────────────
# Run `pnpm doochy:setup` to generate .env automatically. This file documents every
# option and is not loaded by the app. `.env` is git-ignored; this file is not.

# HTTP port. The server binds to 127.0.0.1 only - put nginx in front of it.
PORT=9111

# MongoDB. `pnpm doochy:setup` can start the bundled mongo:7.0 container with Docker.
# The default container publishes 127.0.0.1:27017 only and runs without auth.
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=doochy

# Secret used to sign login JWTs. Generated by `pnpm doochy:setup`.
JWT_SECRET=

# Encrypts integration secrets saved from the admin panel (cTrader, Telegram).
# Must decode to exactly 32 bytes. Generated by `pnpm doochy:setup`.
INTEGRATIONS_ENCRYPTION_KEY=

# HMAC key for public trainer item ids. Generated by `pnpm doochy:setup` so links stay
# stable across restarts.
TRAINER_ITEM_SECRET=

# cTrader "Connect" OAuth (optional). One Doochy-owned Open API app lets
# users approve access in the browser instead of pasting credentials. Register
# these redirect URIs in the cTrader Open API portal:
#   https://<your-domain>/callback
#   https://<your-domain>/api/ctrader/oauth/callback
#   http://localhost:5173/api/ctrader/oauth/callback   (development)
# Leave the client id/secret empty to hide the OAuth button and keep the manual
# credential form only.
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
# Required: must exactly match one of the registered callback URLs. There is
# no built-in fallback, so an unset value disables the OAuth button.
CTRADER_REDIRECT_URI=
# Defaults to "trading" (read accounts + place orders).
CTRADER_OAUTH_SCOPE=trading

# Promote this existing username to admin on every boot. Comma-separate for
# multiple admins. One-off changes: pnpm admin:grant <username> / admin:revoke.
# ADMIN_USERNAME=

# ── Analysis page (market technical analysis) ───────────────────────────────
# Bars are read from cTrader (ProtoOAGetTrendbarsReq), so there is no data-source
# key to configure. The page uses one shared cTrader account, auto-selected as
# the first demo account with credentials. Pin it explicitly if you need to:
#
# MARKET_CTRADER_USER_ID=<mongo user id whose credentials supply the prices>
# MARKET_CTRADER_CTID=<cTrader account id, e.g. 47997639>
#
# Uncomment to configure the Analysis page without using its settings panel:
# REFRESH_SECONDS=60
# DEFAULT_TIMEFRAME=4h
# STRONG_RATIO=0.25

# ── Scraper (in-server replacement for the OpenClaw doochy-scraper cron) ─────
# In-server scheduler. Set false to stand down without removing the code.
SCRAPER_ENABLED=true
# Optional overrides (defaults shown):
# SCRAPER_STATE_FILE=~/doochyweb/data/scraper-state.json
# OPENCLAW_CAPTURES_FILE=~/doochyweb/openclaw-captures.json

# ── Narration (Phase 2, research only) ────────────────────────────────────
# OpenAI-compatible NVIDIA NIM endpoint used by OpenClaw. Add the key to run a
# model bake-off; the template narrator works without it.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Model id. Chosen for narration: nvidia/nemotron-3.5-lightning-30b-a3b
NARRATION_MODEL=
# Reasoning models otherwise spend the whole budget on reasoning and return empty content.
NARRATION_DISABLE_THINKING=true
# Optional for reasoning models that stay on, e.g. ultra 550B: low (needs a larger max_tokens).
# NARRATION_REASONING_EFFORT=low
# Publish a live note when a breakout fires. Off by default; the public feed
# only serves saved, lint-clean notes.
NARRATION_ENABLED=false
# Optional analogue depth for live notes (defaults shown).
# NARRATION_K=20
# NARRATION_DAYS=730
# Optional audit directory (default ~/doochyweb/data/narrations).
# NARRATION_DIR=~/doochyweb/data/narrations

# Twelve Data secondary source (cross-check only). Free plan: FX, XAU, crypto;
# silver and indices need a paid plan. Get a key at twelvedata.com.
TWELVE_DATA_API_KEY=

# ── Telegram signal notifications ───────────────────────────────────────────
# Optional. Leave TELEGRAM_BOT_TOKEN empty to keep the feature off.
# Reuses @DoochyBot; rotate its token in BotFather before deploying.
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=DoochyBot
# Public base URL used in bot links and the "Open on Doochy" button.
PUBLIC_BASE_URL=https://doochy.net
# Link codes are single-use and short-lived.
# TELEGRAM_LINK_TTL_MINUTES=15
