# cTrader Open API credentials (copy from DoochyBot / Doochy source)
# These are app-level credentials, not account passwords.
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCESS_TOKEN=
CTRADER_REFRESH_TOKEN=

# Which cTrader account to read prices from.
# If blank, the script picks the first demo account under the grant.
CTRADER_CTID=

# Output / cache paths (defaults are sensible, rarely need to change)
# CACHE_DIR=./data/candles
# OUT_DIR=./out
